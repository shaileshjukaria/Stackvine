# Production environment — used when you deploy
# IMPORTANT: Change VITE_ADMIN_PATH to something secret and hard to guess!
# Example: VITE_ADMIN_PATH=sv-9k2x-panel

# Set this to a random secret path — only YOU will know this URL
VITE_ADMIN_PATH=sv-admin-panel

# Keep as true — only you will know the secret path
VITE_ADMIN_ENABLED=true
