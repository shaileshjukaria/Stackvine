# Frontend environment variables
# Copy this to .env.local for local dev

# API base URL (used in production — leave empty for local dev proxy)
VITE_API_URL=

# Admin panel secret path — CHANGE THIS in production!
# The admin panel will be at /{VITE_ADMIN_PATH} instead of /admin
# Example: VITE_ADMIN_PATH=sv-panel-x9k2  → yoursite.com/sv-panel-x9k2
# Never share this URL publicly — it's your private admin link
VITE_ADMIN_PATH=admin

# Set to false in production to fully disable the admin panel on the deployed site
# When false: navigating to the admin path returns a 404 page
VITE_ADMIN_ENABLED=true
