# ════════════════════════════════════════════════════════════
#  Stackvine — Root .gitignore
#  Keep credentials, secrets, and generated files off GitHub
# ════════════════════════════════════════════════════════════

# ── Environment files (NEVER commit these) ───────────────────
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local

# ── Node modules ──────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build outputs ─────────────────────────────────────────────
dist/
dist-ssr/
build/
.vite/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS files ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
ehthumbs.db

# ── Editor directories ────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── Package lock (keep package-lock.json but ignore yarn.lock if not used) ──
yarn.lock

# ── Runtime / temp ────────────────────────────────────────────
*.local
.cache/
tmp/
temp/

# ── Test coverage ─────────────────────────────────────────────
coverage/
.nyc_output/

# ── Sensitive credentials (belt and suspenders) ──────────────
*.pem
*.key
*.p12
*.pfx
*.cert
secrets.json
credentials.json
service-account.json
